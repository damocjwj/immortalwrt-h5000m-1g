# Hiveton H5000M 1G/8GB: reproducible minimal image configuration.
# Apply with: cp config/h5000m-1g-minimal.config .config && make defconfig

CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_hiveton-h5000m-1g=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_ROOTFS_INITRAMFS_SEPARATE=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_PARTSIZE=7311
# H5000M boots from eMMC GPT and uses F2FS for the writable overlay.  Do not
# enable target-wide UBIFS/NAND support merely to build unused UBI utilities.
# CONFIG_USES_UBIFS is not set
# CONFIG_FSTOOLS_UBIFS_EXTROOT is not set
# CONFIG_DEFAULT_block-mount is not set

CONFIG_PACKAGE_trusted-firmware-a-mt7987-emmc-comb=y
CONFIG_PACKAGE_u-boot-mt7987_hiveton_h5000m-1g-emmc=y

CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_dnsmasq-full=y

CONFIG_PACKAGE_kmod-mt798x-2p5g-phy=y
CONFIG_PACKAGE_mt798x-2p5g-phy-firmware-internal=y
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_kmod-br-netfilter=y
CONFIG_PACKAGE_kmod-mediatek_hnat=y
CONFIG_PACKAGE_kmod-warp=y
CONFIG_PACKAGE_mtk-smp=y
CONFIG_PACKAGE_kmod-mt_wifi_cmn=y
CONFIG_PACKAGE_kmod-mt_wifi7=y
CONFIG_PACKAGE_kmod-mt_hwifi=y
CONFIG_PACKAGE_kmod-mtk_pci=y
CONFIG_PACKAGE_kmod-mtk_wed=y
CONFIG_PACKAGE_kmod-connac_if=y
CONFIG_PACKAGE_kmod-mt7992=y
CONFIG_PACKAGE_wifi-dats=y
CONFIG_PACKAGE_mtwifi-cfg=y
CONFIG_PACKAGE_luci-app-mtwifi-cfg=y
CONFIG_first_card=y
CONFIG_first_card_name="MT7992"
CONFIG_second_card=y
CONFIG_second_card_name="MT7992"
# CONFIG_third_card is not set

CONFIG_PACKAGE_luci-app-modem=y
CONFIG_PACKAGE_luci-i18n-modem-zh-cn=y
CONFIG_PACKAGE_quectel-CM-5G=y
CONFIG_PACKAGE_sms-tool=y
CONFIG_PACKAGE_kmod-usb-acm=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-qualcomm=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y
CONFIG_PACKAGE_kmod-usb-wdm=y

CONFIG_PACKAGE_kmod-hwmon-pwmfan=y
CONFIG_PACKAGE_fancontrol=y
CONFIG_PACKAGE_luci-app-fancontrol=y

CONFIG_PACKAGE_kmod-mt799a=y
# CONFIG_PACKAGE_kmod-mt7992_dbg is not set
# Keep the MTK HNAT/WED management page available in both recovery and
# production so acceleration settings can be inspected after fallback boot.
CONFIG_PACKAGE_luci-app-turboacc-mtk=y
CONFIG_PACKAGE_luci-i18n-turboacc-mtk-zh-cn=y
# These are inherited MediaTek transparent-proxy defaults.  Recovery does not
# run a transparent proxy, so keep them out of both its image and Kconfig.
# CONFIG_DEFAULT_kmod-dummy is not set
# CONFIG_DEFAULT_kmod-inet-diag is not set
# CONFIG_DEFAULT_kmod-nf-socket is not set
# CONFIG_DEFAULT_kmod-nf-tproxy is not set
# CONFIG_DEFAULT_kmod-nft-socket is not set
# CONFIG_DEFAULT_kmod-nft-tproxy is not set
# CONFIG_DEFAULT_kmod-tun is not set
CONFIG_PACKAGE_kmod-tcp-bbr=y
# firewall4 requires nftables NAT independently of TurboACC.
CONFIG_PACKAGE_kmod-nft-nat=y
# CONFIG_PACKAGE_kmod-ipt-nat6 is not set
# CONFIG_PACKAGE_kmod-ipt-nat is not set
# CONFIG_PACKAGE_kmod-netlink-diag is not set
# CONFIG_PACKAGE_kmod-ipt-physdev is not set
# CONFIG_PACKAGE_kmod-nf-ipvs is not set
# CONFIG_PACKAGE_kmod-veth is not set
# CONFIG_PACKAGE_kmod-wireguard is not set
# CONFIG_PACKAGE_kmod-ipt-fullconenat is not set
# CONFIG_PACKAGE_kmod-fs-btrfs is not set
# CONFIG_PACKAGE_luci-app-ttyd is not set
# CONFIG_PACKAGE_ttyd is not set
# CONFIG_PACKAGE_kmod-bonding is not set
# CONFIG_PACKAGE_luci-app-eqos-mtk is not set
# CONFIG_PACKAGE_luci-app-Airpifanctrl is not set
# CONFIG_PACKAGE_mtkhqos_util is not set
# CONFIG_PACKAGE_kmod-phy-aquantia is not set
# CONFIG_PACKAGE_modemmanager is not set
# CONFIG_PACKAGE_luci-proto-modemmanager is not set
# CONFIG_PACKAGE_luci-proto-qmi is not set
# CONFIG_PACKAGE_luci-proto-mbim is not set
# CONFIG_PACKAGE_uqmi is not set
# CONFIG_PACKAGE_umbim is not set
# CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm is not set
# These generic defaults are not part of the H5000M router image.  They are
# also excluded in Device/hiveton-h5000m as a second line of defense.
# CONFIG_PACKAGE_shellsync is not set
# CONFIG_PACKAGE_kmod-macvlan is not set
# CONFIG_PACKAGE_kmod-udptunnel4 is not set
# CONFIG_PACKAGE_kmod-udptunnel6 is not set
# CONFIG_PACKAGE_mtd is not set
# CONFIG_PACKAGE_ubi-utils is not set
# Generic Full-cone is not MTK HNAT and is not part of the MTK-only console.
# CONFIG_PACKAGE_iptables-mod-fullconenat is not set
# H5000M has neither DSL nor ATM hardware.  Keep Ethernet PPPoE, not PPPoA.
# CONFIG_PACKAGE_linux-atm is not set
# CONFIG_PACKAGE_ppp-mod-pppoa is not set
# CONFIG_PACKAGE_luci-app-passwall is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Haproxy is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Hysteria is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_NaiveProxy is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Server is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadow_TLS is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Simple_Obfs is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_tuic_client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geodata is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geoview is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Plugin is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray_Plugin is not set
# CONFIG_PACKAGE_luci-app-rclone is not set
# CONFIG_PACKAGE_luci-app-rclone_INCLUDE_rclone-webui is not set
# CONFIG_PACKAGE_luci-app-rclone_INCLUDE_rclone-ng is not set
# CONFIG_PACKAGE_rclone is not set
# CONFIG_PACKAGE_luci-app-frpc is not set
# CONFIG_PACKAGE_frpc is not set
# CONFIG_PACKAGE_ruby is not set
# CONFIG_PACKAGE_bash is not set
# CONFIG_PACKAGE_htop is not set
CONFIG_PACKAGE_mkf2fs=y
CONFIG_PACKAGE_f2fsck=y
# CONFIG_PACKAGE_natmap is not set
# CONFIG_PACKAGE_luci-app-natmap is not set
# CONFIG_PACKAGE_luci-app-diskman is not set
# The 8GB layout has no userdata partition and needs no generic mount/ext4
# administration stack.  fitblk and F2FS overlay support remain selected by
# the device and base filesystem dependencies.
# CONFIG_PACKAGE_block-mount is not set
# CONFIG_PACKAGE_e2fsprogs is not set
# CONFIG_PACKAGE_kmod-usb-storage is not set
# CONFIG_PACKAGE_kmod-usb-storage-extras is not set
# CONFIG_PACKAGE_kmod-usb-storage-uas is not set
# CONFIG_PACKAGE_kmod-fs-ext4 is not set
# CONFIG_PACKAGE_kmod-fs-vfat is not set
# CONFIG_PACKAGE_kmod-fs-exfat is not set
# CONFIG_PACKAGE_kmod-fs-ntfs is not set
# CONFIG_PACKAGE_kmod-fs-ntfs3 is not set

# CONFIG_DEVEL is not set
# CONFIG_AUTOREBUILD is not set
# CONFIG_COLLECT_KERNEL_DEBUG is not set
# CONFIG_REPRODUCIBLE_DEBUG_INFO is not set
# The proprietary MTK HWIFI device-registration path requires debugfs to
# create its internal resource tree.  Keep the filesystem enabled, but leave
# kernel debugging, tracing, BTF and debug information disabled below.
CONFIG_KERNEL_DEBUG_FS=y
# CONFIG_KERNEL_DEBUG_KERNEL is not set
# CONFIG_KERNEL_DEBUG_INFO is not set
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
# CONFIG_KERNEL_DEBUG_INFO_BTF is not set
# CONFIG_KERNEL_DEBUG_INFO_BTF_MODULES is not set
# CONFIG_KERNEL_FTRACE is not set
# CONFIG_KERNEL_FTRACE_SYSCALLS is not set
# CONFIG_KERNEL_KPROBES is not set
# CONFIG_KERNEL_KPROBES_ON_FTRACE is not set
# CONFIG_KERNEL_PERF_EVENTS is not set
# CONFIG_KERNEL_PROFILING is not set
# CONFIG_PACKAGE_gdb is not set
# CONFIG_PACKAGE_gdbserver is not set
# CONFIG_PACKAGE_perf is not set
# CONFIG_PACKAGE_debugfs is not set

# Preserve the MT7992 vendor driver ABI from the branch baseline.
CONFIG_MTK_HWIFI_PCI_SUPPORT=y
CONFIG_MTK_HWIFI_CONNAC_IF_SUPPORT=y
CONFIG_MTK_HWIFI_WED_SUPPORT=y
# CONFIG_MTK_HWIFI_FW_HDR_SUPPORT is not set
# CONFIG_MTK_HWIFI_MD_COEX_SUPPORT is not set
# CONFIG_MTK_HWIFI_SW_AMSDU is not set
CONFIG_MTK_HWIFI_RX_PROCESS_WORKQUEUE=y
# CONFIG_MTK_HWIFI_MEM_SHRINK is not set
# CONFIG_MTK_HWIFI_FW_BE5040 is not set
# CONFIG_MTK_HWIFI_FW_BE5040_20260310 is not set
# CONFIG_MTK_HWIFI_MT7915 is not set
# CONFIG_MTK_HWIFI_MT7916 is not set
# CONFIG_MTK_HWIFI_BELLWETHER is not set
# CONFIG_MTK_HWIFI_MT7990 is not set
# CONFIG_MTK_HWIFI_MT7991 is not set
CONFIG_MTK_HWIFI_MT7992=y
# MT799A is a vendor MT7992 companion component.  Keep the matching
# ImmortalWrt branch ABI intact rather than treating this as an extra radio.
CONFIG_MTK_HWIFI_MT799A=y
# CONFIG_MTK_HWIFI_MT7993 is not set
# CONFIG_MTK_HWIFI_BLACKHAWK_A0 is not set
CONFIG_MTK_HWIFI_MT7992_RRO_MODE=4
CONFIG_MTK_HWIFI_MT7992_OPTION_TYPE=0
CONFIG_MTK_HWIFI_MT7992_INTR_OPTION_SET=0
CONFIG_MTK_WIFI7_SUPPORT_OPENWRT=y
CONFIG_MTK_WIFI7_DRIVER=y
CONFIG_MTK_WIFI7_UNIFIED_COMMAND=y
CONFIG_MTK_WIFI7_DOT11_N_SUPPORT=y
CONFIG_MTK_WIFI7_DOT11_AX_SUPPORT=y
CONFIG_MTK_WIFI7_DOT11_BE_SUPPORT=y
CONFIG_MTK_WIFI7_MT_MAC=y
CONFIG_MTK_WIFI7_CHIP_MT7992=y
# CONFIG_MTK_WIFI7_FIRST_IF_NONE is not set
# CONFIG_MTK_WIFI7_FIRST_IF_MT7915 is not set
# CONFIG_MTK_WIFI7_FIRST_IF_MT7990 is not set
# CONFIG_MTK_WIFI7_FIRST_IF_BELLWETHER is not set
CONFIG_MTK_WIFI7_FIRST_IF_MT7992=y
# CONFIG_MTK_WIFI7_FIRST_IF_MT7993 is not set
# CONFIG_MTK_WIFI7_FIRST_IF_BLACKHAWK is not set
# CONFIG_MTK_WIFI7_SECOND_IF_NONE is not set
# CONFIG_MTK_WIFI7_SECOND_IF_MT7915 is not set
# CONFIG_MTK_WIFI7_SECOND_IF_MT7990 is not set
# CONFIG_MTK_WIFI7_SECOND_IF_BELLWETHER is not set
CONFIG_MTK_WIFI7_SECOND_IF_MT7992=y
# CONFIG_MTK_WIFI7_SECOND_IF_MT7993 is not set
CONFIG_MTK_WIFI7_THIRD_IF_NONE=y
# CONFIG_MTK_THIRD_IF_MT7915 is not set
# CONFIG_MTK_THIRD_IF_MT7990 is not set
# CONFIG_MTK_THIRD_IF_MT7992 is not set
# CONFIG_MTK_THIRD_IF_MT7993 is not set
CONFIG_MTK_WIFI7_FIRST_IF_RF_OFFSET=0xc0000
CONFIG_MTK_WIFI7_SECOND_IF_RF_OFFSET=0xc8000
CONFIG_MTK_WIFI7_MT_WIFI=m
CONFIG_MTK_WIFI7_MT_WIFI_PATH="mt_wifi"
CONFIG_MTK_WIFI7_HWIFI_SUPPORT=y
CONFIG_MTK_WIFI7_PROXYARP_SUPPORT=y
CONFIG_MTK_WIFI7_OFFCHANNEL_SUPPORT=y
CONFIG_MTK_WIFI7_BS_MAP_BL_SUPPORT=y
# CONFIG_MTK_WIFI7_PWHM_SUPPORT is not set
# CONFIG_MTK_WIFI7_OSAL_SUPPORT is not set
CONFIG_MTK_WIFI7_FIRST_IF_EEPROM_FLASH=y
# CONFIG_MTK_WIFI7_FIRST_IF_EEPROM_PROM is not set
# CONFIG_MTK_WIFI7_FIRST_IF_EEPROM_EFUSE is not set
CONFIG_MTK_WIFI7_RT_FIRST_IF_RF_OFFSET=0xc0000
CONFIG_MTK_WIFI7_RT_SECOND_IF_RF_OFFSET=0xc8000
CONFIG_MTK_WIFI7_RT_THIRD_IF_RF_OFFSET=0xd0000
CONFIG_MTK_WIFI7_MULTI_INF_SUPPORT=y
# CONFIG_MTK_WIFI7_6G_AFC_SUPPORT is not set
CONFIG_MTK_WIFI7_BASIC_FUNC=y
CONFIG_MTK_WIFI7_DOT11_VHT_AC=y
CONFIG_MTK_WIFI7_DOT11_HE_AX=y
CONFIG_MTK_WIFI7_DOT11_EHT_BE=y
CONFIG_MTK_WIFI7_CFG_SUPPORT_FALCON_MURU=y
CONFIG_MTK_WIFI7_CFG_SUPPORT_FALCON_TXCMD_DBG=y
CONFIG_MTK_WIFI7_CFG_SUPPORT_FALCON_SR=y
CONFIG_MTK_WIFI7_CFG_SUPPORT_FALCON_PP=y
CONFIG_MTK_WIFI7_WIFI_TWT_SUPPORT=y
CONFIG_MTK_WIFI7_G_BAND_256QAM_SUPPORT=y
# CONFIG_MTK_WIFI7_BRCM_256QAM_SUPPORT is not set
# CONFIG_MTK_WIFI7_VHT_TXBF_2G_EPIGRAM_IE_SUPPORT is not set
CONFIG_MTK_WIFI7_TPC_SUPPORT=y
CONFIG_MTK_WIFI7_ICAP_SUPPORT=y
CONFIG_MTK_WIFI7_SPECTRUM_SUPPORT=y
CONFIG_MTK_WIFI7_PHY_ICS_SUPPORT=y
CONFIG_MTK_WIFI7_BACKGROUND_SCAN_SUPPORT=y
CONFIG_MTK_WIFI7_SMART_CARRIER_SENSE_SUPPORT=y
