# Hiveton H5000M release-kernel overrides.
# This file is appended after the complete generic and Filogic vendor
# fragments only when
# CONFIG_TARGET_mediatek_filogic_DEVICE_hiveton-h5000m-1g=y.
# Keep hardware and MTK driver choices in the vendor fragments; only remove
# development, debug, and self-test facilities from the final kernel.  The
# proprietary HWIFI registration path requires debugfs for its resource tree.

# CONFIG_DEBUG_KERNEL is not set
# CONFIG_DEBUG_BUGVERBOSE is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_MISC is not set
# CONFIG_DEBUG_INFO_BTF is not set
CONFIG_DEBUG_FS=y
# CONFIG_FTRACE is not set
# CONFIG_KPROBES is not set
# CONFIG_PERF_EVENTS is not set
# CONFIG_PROFILING is not set
# CONFIG_GDB_SCRIPTS is not set
# CONFIG_KGDB is not set

# CONFIG_DMATEST is not set
# CONFIG_NET_SELFTESTS is not set
# CONFIG_PCI_DEBUG is not set
# CONFIG_MTK_LVTS_THERMAL_DEBUGFS is not set
