msgid "Fan Control"
msgstr "风扇控制"

msgid "Live Status"
msgstr "实时状态"

msgid "CPU Temperature"
msgstr "CPU温度"

msgid "Fan PWM"
msgstr "风扇 PWM"

msgid "Fan Settings"
msgstr "风扇设置"

msgid "Fan Curve"
msgstr "风扇曲线"

msgid "Apply & Restart"
msgstr "应用并重启"

msgid "Reset Default"
msgstr "恢复默认"

msgid "Settings"
msgstr "设置"

