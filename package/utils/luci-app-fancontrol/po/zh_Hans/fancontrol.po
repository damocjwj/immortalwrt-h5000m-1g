msgstr "温度失效判定次数"

msgid "Saved. Restarting service..."
msgstr "已保存，正在重启服务..."

msgid "Applying..."
msgstr "正在应用..."

msgid "Saved and service restarted."
msgstr "已保存并重启服务。"

msgid "Service restart failed."
msgstr "服务重启失败。"

msgid "Unable to apply settings: %s"
msgstr "无法应用设置：%s"

msgid "Failed to save configuration: %s"
msgstr "保存配置失败：%s"

msgid "Unable to reset form: %s"
msgstr "无法复位表单：%s"

msgid "Unable to restart fancontrol: %s"
msgstr "无法重启 fancontrol：%s"

msgid "Invalid fan curve input: %s"
msgstr "风扇曲线输入无效：%s"

msgid "Please enter a valid number."
msgstr "请输入有效数字。"

msgid "Temperature must be between 0 and 100°C."
msgstr "温度必须在 0 到 100°C 之间。"

msgid "PWM must be between 0 and 255."
msgstr "PWM 必须在 0 到 255 之间。"

msgid "Temperature must increase by at least 5°C."
msgstr "温度必须至少递增 5°C。"

msgid "PWM must not decrease."
msgstr "PWM 不能下降。"
