#!/bin/sh

. /lib/functions.sh

kernel_ver="$(uname -r)"

has_module_file() {
	local module

	for module in "$@"; do
		set -- "/lib/modules/$kernel_ver/$module.ko"*
		[ -e "$1" ] && return 0
	done

	return 1
}

case "$(board_name)" in
hiveton,h5000m|hiveton,h5000m-1g)
	uci -q set "turboacc.config.fastpath"="mediatek_hnat"
	uci -q set "turboacc.config.fastpath_mh_eth_hnat"="1"
	uci -q set "turboacc.config.fastpath_mh_eth_hnat_v6"="1"
	uci -q set "turboacc.config.fastpath_mh_eth_hnat_bind_rate"="30"
	uci -q set "turboacc.config.tcpcca"="cubic"
	;;
*)
	if has_module_file "mtkhnat" "mediatek_hnat"; then
	uci -q set "turboacc.config.fastpath"="mediatek_hnat"
	uci -q set "turboacc.config.fastpath_mh_eth_hnat"="1"
	uci -q set "turboacc.config.fastpath_mh_eth_hnat_v6"="1"
		uci -q set "turboacc.config.fastpath_mh_eth_hnat_bind_rate"="30"
	else
		uci -q set "turboacc.config.fastpath"="none"
	fi
	;;
esac

# Remove options from the former generic multi-engine implementation.  They
# are unsupported by the MTK-only backend and must not survive sysupgrade.
for option in \
	fastpath_fo_hw fastpath_fc_br fastpath_fc_ipv6 \
	fastpath_mh_eth_hnat_ap fastpath_mh_eth_hnat_ppenum fullcone; do
	uci -q delete "turboacc.config.$option"
done

uci -q commit "turboacc"

uci -q batch <<-EOF >/dev/null
	delete ucitrack.@turboacc[-1]
	add ucitrack turboacc
	set ucitrack.@turboacc[-1].init='turboacc'
	set ucitrack.@turboacc[-1].config='turboacc'
EOF

uci -q commit "ucitrack"

# Images are populated without package post-install hooks.  Enable the
# backend here so the first boot has the same service state as an opkg install.
[ -x /etc/init.d/turboacc ] && /etc/init.d/turboacc enable >/dev/null 2>&1

rm -f /tmp/luci-indexcache
exit 0
