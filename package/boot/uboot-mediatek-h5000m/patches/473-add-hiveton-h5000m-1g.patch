--- /dev/null
+++ b/defenvs/hiveton_h5000m_1g_emmc_env
@@ -0,0 +1,50 @@
+ipaddr=192.168.1.1
+serverip=192.168.1.254
+loadaddr=0x48000000
+console=earlycon=uart8250,mmio32,0x11000000 console=ttyS0
+bootcmd=run boot_emmc
+bootconf=config-1
+bootdelay=3
+bootfile=immortalwrt-mediatek-filogic-hiveton-h5000m-1g-initramfs-recovery.itb
+bootfile_upg=immortalwrt-mediatek-filogic-hiveton-h5000m-1g-squashfs-sysupgrade.itb
+bootled_status=white:wlan-0
+bootmenu_confirm_return=askenv - Press ENTER to return to menu ; bootmenu 60
+bootmenu_default=0
+bootmenu_delay=3
+bootmenu_title=ImmortalWrt Hiveton H5000M 1G [eMMC]
+bootmenu_0=Boot system from eMMC.=run boot_emmc
+bootmenu_0d=Run default boot command.=run boot_default
+bootmenu_1=Boot system via TFTP.=run boot_tftp ; run bootmenu_confirm_return
+bootmenu_2=Boot production system from eMMC.=run boot_production ; run bootmenu_confirm_return
+bootmenu_3=Boot recovery system from eMMC.=run boot_recovery ; run bootmenu_confirm_return
+bootmenu_4=Load production system via TFTP then write to eMMC.=setenv noboot 1 ; setenv replacevol 1 ; run boot_tftp_production ; setenv noboot ; setenv replacevol ; run bootmenu_confirm_return
+bootmenu_5=Load recovery system via TFTP then write to eMMC.=setenv noboot 1 ; setenv replacevol 1 ; run boot_tftp_recovery ; setenv noboot ; setenv replacevol ; run bootmenu_confirm_return
+bootmenu_6=Reboot.=reset
+bootmenu_7=Reset all settings to factory defaults.=run reset_factory ; reset
+boot_first=if button reset ; then led $bootled_status on ; run boot_tftp_recovery ; setenv flag_recover 1 ; run boot_default ; fi ; bootmenu
+boot_default=if env exists flag_recover ; then else run bootcmd ; fi ; run boot_recovery ; setenv replacevol 1 ; run boot_tftp_forever
+boot_production=led $bootled_status on ; run emmc_read_production && bootm $loadaddr#$bootconf ; led $bootled_status off
+boot_recovery=led $bootled_status on ; run emmc_read_recovery && bootm $loadaddr#$bootconf ; led $bootled_status off
+boot_emmc=run boot_production ; run boot_recovery
+boot_tftp_forever=led $bootled_status on ; while true ; do run boot_tftp_recovery ; sleep 1 ; done
+boot_tftp_production=if tftpboot $loadaddr $bootfile_upg && iminfo $loadaddr && run tftp_fit_size_check; then if env exists replacevol; then run emmc_write_production; fi; if env exists noboot; then true; else bootm $loadaddr#$bootconf; fi; fi
+boot_tftp_recovery=if tftpboot $loadaddr $bootfile && iminfo $loadaddr && run tftp_recovery_size_check; then if env exists replacevol; then run emmc_write_recovery; fi; if env exists noboot; then true; else bootm $loadaddr#$bootconf; fi; fi
+boot_tftp=if tftpboot $loadaddr $bootfile && iminfo $loadaddr && run tftp_recovery_size_check; then bootm $loadaddr#$bootconf; fi
+boot_fit_max_blocks=30000
+boot_fit_max_size=6000000
+recovery_fit_max_size=6000000
+fit_size_check=imszb $loadaddr image_size && test 0x$image_size -le 0x$boot_fit_max_blocks
+tftp_fit_size_check=test 0x$filesize -le 0x$boot_fit_max_size && run fit_size_check
+tftp_recovery_size_check=test 0x$filesize -le 0x$recovery_fit_max_size && run fit_size_check
+mmc_write_vol=run fit_size_check && test 0x$image_size -le 0x$part_size && mmc write $loadaddr 0x$part_addr 0x$image_size
+mmc_read_vol=mmc read $loadaddr 0x$part_addr 0x100 && run fit_size_check && test 0x$image_size -le 0x$part_size && mmc read $loadaddr 0x$part_addr 0x$image_size && setexpr filesize $image_size * 0x200
+part_default=production
+part_recovery=recovery
+gpt_layout=name=ubootenv,start=4M,size=512K;name=factory,start=4608K,size=4M;name=fip,start=8704K,size=4M;name=recovery,start=16M,size=128M;name=production,size=-
+gpt_write_layout=mmc dev 0 && gpt write mmc 0 $gpt_layout && gpt verify mmc 0 $gpt_layout
+reset_factory=eraseenv && reset
+gpt_select_part=gpt setenv mmc 0 $part_name && setenv part_addr $gpt_partition_addr && setenv part_size $gpt_partition_size
+emmc_read_production=mmc dev 0 && setenv part_name $part_default && run gpt_select_part && run mmc_read_vol
+emmc_read_recovery=mmc dev 0 && setenv part_name $part_recovery && run gpt_select_part && run mmc_read_vol
+emmc_write_production=mmc dev 0 && setenv part_name $part_default && run gpt_select_part && run mmc_write_vol
+emmc_write_recovery=mmc dev 0 && setenv part_name $part_recovery && run gpt_select_part && run mmc_write_vol
